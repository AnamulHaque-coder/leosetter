{
  "name": "LeoSetter Sunset Palette",
  "description": "Dark theme with coral-to-violet sunset gradient accents and glassmorphism effects",
  "core": {
    "background": { "hsl": "260 25% 6%", "hex": "#0e0b14" },
    "foreground": { "hsl": "0 0% 98%", "hex": "#fafafa" },
    "primary": { "hsl": "350 85% 62%", "hex": "#e84466" },
    "primary-foreground": { "hsl": "0 0% 100%", "hex": "#ffffff" },
    "accent": { "hsl": "320 75% 60%", "hex": "#d94dab" },
    "accent-foreground": { "hsl": "0 0% 100%", "hex": "#ffffff" },
    "card": { "hsl": "260 20% 11%", "hex": "#1a1524" },
    "card-foreground": { "hsl": "0 0% 98%", "hex": "#fafafa" },
    "secondary": { "hsl": "260 18% 16%", "hex": "#27212f" },
    "secondary-foreground": { "hsl": "0 0% 90%", "hex": "#e6e6e6" },
    "muted": { "hsl": "260 15% 18%", "hex": "#2d2735" },
    "muted-foreground": { "hsl": "260 10% 55%", "hex": "#8f8599" },
    "border": { "hsl": "260 18% 20%", "hex": "#322b3c" },
    "input": { "hsl": "260 18% 20%", "hex": "#322b3c" },
    "ring": { "hsl": "350 85% 62%", "hex": "#e84466" },
    "destructive": { "hsl": "0 84% 60%", "hex": "#ef4444" },
    "destructive-foreground": { "hsl": "210 40% 98%", "hex": "#f8fafc" }
  },
  "gradients": {
    "text-gradient": {
      "type": "linear-gradient",
      "angle": "135deg",
      "stops": [
        { "hsl": "20 95% 65%", "hex": "#f28c5e", "label": "Peach orange" },
        { "hsl": "350 85% 65%", "hex": "#ec5572", "label": "Coral" },
        { "hsl": "300 70% 65%", "hex": "#d170c7", "label": "Orchid" }
      ]
    },
    "mesh": {
      "colors": [
        { "hsl": "350 80% 50%", "hex": "#e62e52", "label": "Warm red" },
        { "hsl": "280 70% 50%", "hex": "#9b30d1", "label": "Violet" },
        { "hsl": "320 75% 55%", "hex": "#d44a9e", "label": "Magenta" },
        { "hsl": "30 90% 55%", "hex": "#e88a1a", "label": "Warm orange" }
      ]
    }
  },
  "glassmorphism": {
    "glass-bg": "hsl(260 20% 100% / 0.06)",
    "glass-bg-hover": "hsl(260 20% 100% / 0.1)",
    "glass-border": "hsl(260 20% 100% / 0.12)",
    "glass-border-strong": "hsl(260 20% 100% / 0.2)",
    "blur": "20px",
    "blur-heavy": "40px"
  },
  "glows": {
    "glow-primary": { "hsl": "350 85% 62%", "hex": "#e84466" },
    "glow-accent": { "hsl": "320 75% 60%", "hex": "#d94dab" }
  }
}
